# The browser only ever gets these two. Both are safe to ship in the bundle:
# the anon key is public by design, and row-level security is what decides
# what it can actually read.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The service role key is NOT here, and must never be. It bypasses every
# policy, so it lives only as a secret on the admin-users edge function,
# where Supabase injects it. See README step 4.
